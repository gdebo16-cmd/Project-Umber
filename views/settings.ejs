<!DOCTYPE html>
<html lang="'en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Tangerine:wght@400;700&display=swap" rel="stylesheet">
    <link id="theme-style" rel="stylesheet" href="home.css">
    <title>Eldrid Tales</title>
</head>

<body>
    <header id="topContainer">
        <h1 id="siteTitle">
            Welcome <%= username %>, To Eldridia
        </h1>

        <nav id="navBox">
            <ul id="navContainer">
                <a id="homeNav" class="navButton" href="/home">home</a>
            
                <li id="characterNav" class="navButton">Characters
                        <ul class="dropDown" id="characterDropdown">
                            <a id="createCharacter" class="characterDropdownButton" href="/create_char">Create Character</a>
                            <a id="characterList" class="characterDropdownButton" href="/char_list">Character List</a>
                        </ul>
                </li>
                
                <li id="campaignNav" class="navButton">Campaigns
                    <ul class="dropDown" id="campaignDropdown">
                        <a id="createCampaign" class="campaignDropdownButton" href="/create_campaign">Create Campaign</a>
                        <a id="campaignList" class="campaignDropdownButton" href="/campaign_list">Campaign List</a>
                        <a id="premadeCampaigns" class="campaignDropdownButton" href="/premade">Premade Campaigns</a>
                    </ul>
                </li>

                <li id="settingsNav" class="navButton">Settings
                    <ul class="dropDown" id="settingsDropdown">
                        <a id="profile" class="settingsDropdownButton" href="/profile">Profile</a>
                        <a id="settings" class="settingsDropdownButton" href="/settings">Settings</a>
                        <a id="logout" class="settingsDropdownButton" href="/login">Log Out</a>
                    </ul>
                </li>
                
            </ul>
        </nav>
    </header>
       
    <main>
        <section id="formContainer">
            <article id="formTitle">
                <h2 id="titleText">Settings</h2>
                <h3 id="subTitleText">Account Information</h3>
            </article>
            <form class="formContainer" action="/settings" method="POST">
                <article id="userNameContainer" class="formSectionContainer tile">
                    <label class="topTile" for="username">Username</label>
                    <input class="bottomTile" type="text" id="username" name="username" value="<%= username %>">
                </article>
                    
                <article id="emailContainer" class="formSectionContainer tile">
                    <label class="topTile" for="email">Email</label>
                    <input class="bottomTile" type="email" id="email" name="email" value="<%= email %>">
                </article>
                
                
                <article id="passwordContainer" class="formSectionContainer tile">
                    <label class="topTile" for="password">Password</label>
                    <input class="bottomTile" type="password" id="password" name="password" value="">
                </article>
                
                <article id="buttonContainer" class="formSectionContainer">
                    <button class="formButton" id="submit" type="submit">Update Account</button>
                </article>
                </form>
        </section>
    </main>
    <footer>
        <a id="homeLink" href="/home">Back to home</a>
        <p id="footerText">copyrite Eldrid Tales LLC</p>
    </footer>
</body>
</html>