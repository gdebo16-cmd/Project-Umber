<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Tangerine:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/char_create.css">
  <title>Create Character — Step 1</title>
</head>

<body>
  <header id="topContainer">
    <h1 id="siteTitle">Create Character</h1>
    <h2 id="formTitle">Step 1 of 3 — Name and race</h2>
  </header>

  <main>
    <section id="formContainer">
      <form class="formContainer" action="/create_char/step1" method="POST">
        <article id="charNameContainer" class="formSectionContainer tile">
          <label class="topTile" for="name">Character name</label>
            <input class="bottomTile" type="text" id="name" name="name" required>
        </article>
        <article id="raceSelectContainer" class="formSectionContainer tile">
        <label class="topTile" for="race_id">Race</label>
            <select class="bottomTile" id="race_id" name="race_id" required>
              <option value="" disabled selected>Select your Race</option>
              <% races.forEach(r => { %> 
                <option value="<%= r.id %>" data-img= "<%= r.img_url %>" data-desc= "<%= r.traits %>"><%= r.name %></option> 
              <% }); %>
            </select>  
        </article>
        <article id="buttonContainer" class="formSectionContainer">
          <button id="submit" type="submit">Next: Class</button>
        </article>
      </form>
    </section>
    <section id="descContainer" class="tile" hidden>
      <img id="descImg" class="topTile" src="" alt=''>
      <p id="descText" class="bottomTile"></p>
    </section>
  </main>
  <footer>
    <a id="homeLink" href="/home">Home</a>
  </footer>
  <script src="/char_step1.js"></script>
  </body>
  </html>