<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Tangerine:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/char_create.css">
    <title>Create Character — Step 2</title>
</head>

<body>
  <header id="topContainer">
    <h1 id="siteTitle">Create Character</h1>
    <h2 id="formTitle">Step 2 of 3 — Class and Subclass</h2>
  </header>

  <main>
      <section id="formContainer">
        <form class="formContainer" action="/create_char/step2" method="POST">
          <article id="classContainer" class="formSectionContainer tile">
            <label class="topTile" for="class_id">Select Class</label>
              <select class="bottomTile" id="class_id" name="class_id" required>
                <option value="" disabled selected>Select your Class</option>
                <% classes.forEach(c => { %>
                  <option 
                  value="<%= c.id %>" 
                  data-img= "<%= c.img_url %>" 
                  data-desc= "Description: <%= c.description %>&#10; Primary stat: <%= c.primary_stat %>&#10;  Hitpoint die: <%= c.hitpoint_die %>">
                  <%= c.name %></option> 
                <% }); %>
              </select>
          </article>

          <article id="subClassContainer" class="formSectionContainer tile">
          <label class="topTile" for="subclass_id">Select Subclass</label>
            <select class="bottomTile" id="subclass_id" name="subclass_id" required disabled>
              <option value="" disabled selected>Select your Sub-Class</option>
            </select>
          </article>
          <article id="buttonContainer" class="formSectionContainer">
            <button id="submit" type="submit">Next: Abilities</button>
          </article>
        </form>
    </section>
    <section id="descContainer" class="tile" hidden>
      <img id="descImg" class="topTile" src="" alt=''>
      <p id="descText" class="bottomTile"></p>
    </section> 
    </main>
    <footer>
      <a id="homeLink" href="/home">Cancel</a>
    </footer>
    <script src="/char_step2.js"></script>
  </body>
  </html>