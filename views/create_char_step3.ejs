<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Tangerine:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/char_create.css">
    <title>Create Character — Step 2</title>
</head>

<body>
    <header id="topContainer">
      <h1 id="siteTitle">Create Character</h1>
      <h2 id="formTitle">Step 3 of 3 — Abilities</h2>
    </header>
    <main>
        <section id="section3Title">
            <h2>Roll for your Abilities</h2>
        </section>
        <section id="formContainerStep3">
            <form class="formContainer" action="/create_char/step3" method="POST">
                    <% const stats = [["str","Strength"],["dex","Dexterity"],["con","Constitution"],["int","Intelligence"],
                        ["wis","Wisdom"],["cha","Charisma"],["luc","Luck"],["spd","Speed"]]; %>
    
                    <article id="plus2Container" class="formSectionContainer tile">
                        <label class="topTile" for="plus2">+2 bonus</label>
                        <select class="bottomTile" id="plus2" name="plus2" required>
                            <option value="" disabled selected>Select a +2 stat</option>
                            <% stats.forEach(([key, label]) => { %>
                            <option value="<%= key %>"><%= label %></option>
                            <% }); %>
                        </select>
                    </article>
                    
                    <article id="plus1Container" class="formSectionContainer tile">
                        <label class="topTile" for="plus1">+1 bonus</label>
                        <select class="bottomTile" id="plus1" name="plus1" required>
                            <option value="" disabled selected>Select a +1 stat</option>
                            <% stats.forEach(([key, label]) => { %>
                            <option value="<%= key %>"><%= label %></option>
                            <% }); %>
                        </select>
                    </article>
                    
                <article id="baseStatContainer" class="formSectionContainer">
                    <% stats.forEach(([key, label]) => { %>
                        <article id="baseStatItemContainer" class="formSectionContainer tile">
                            <span class="topTile"><%= label %></span>
                            <button id="rollBtn" type="button" class="bottomTile rollBtn" data-stat="<%= key %>"
                                <%= rolls[key] !== undefined ? "disabled" : "" %>>
                                <%= rolls[key] ?? "roll" %>
                              </button>
                        </article>
                    <% }); %>
                    </article>
            
                <article id="buttonContainer" class="formSectionContainer">
                    <button id="submit" class="formButton" type="submit">Create Character</button>
                </article>
            </form>
        </section>
    </main>
    <footer>
        <a id="homeLink" href="/home">Cancel</a>
    </footer>
    <script src="/char_step3.js"></script>
</body>
</html>